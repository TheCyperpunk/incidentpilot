NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_TRIAGE_MODEL=gpt-5.6-luna

# The Next.js app connects to the isolated runner over a private network.
CODEX_RUNNER_URL=
RUNNER_SHARED_SECRET=

# GitHub App settings. Keep these server-only. The App needs only Contents: Read-only.
# Store the PEM on one line with literal \n characters, or use your host's secret manager.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Local development alternative: absolute path to the PEM file. Do not use
# this in a deployed environment; use a server-side secret instead.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/github/callback

# Set only in the runner environment, never in the Next.js app or browser.
CODEX_API_KEY=
# Comma-separated GitHub account / organization logins that the private runner
# may clone from. The app validates each selected repository before calling it.
RUNNER_ALLOWED_OWNERS=your-user,your-organization

# Read-only Sentry API access for the dashboard. Do not reuse the source-map
# upload token stored in .env.sentry-build-plugin.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
